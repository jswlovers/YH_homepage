# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채우세요.
# .env.local은 .gitignore에 의해 커밋되지 않습니다.

# "개인 비서" 페이지 접근 비밀번호
ASSISTANT_PASSWORD=change-me

# 로그인 세션 쿠키 서명용 비밀키 (임의의 긴 무작위 문자열, 노출 금지)
# 예: openssl rand -hex 32
ASSISTANT_SESSION_SECRET=change-me-too

# Anthropic API 키 (console.anthropic.com에서 발급)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 사용할 모델 (선택, 비워두면 기본값 사용)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
